"""
Task Timer - 简易任务耗时统计工具
"""

import time
import csv
from datetime import datetime
from contextlib import contextmanager


class TaskTimer:
    def __init__(self):
        self.running = {}
        self.records = []

    def start(self, task_name: str):
        if task_name in self.running:
            print(f"[警告] 任务 '{task_name}' 已在运行")
            return

        start_time = time.time()
        self.running[task_name] = start_time
        print(f"[开始] {task_name} at {self._now_str()}")

    def end(self, task_name: str):
        if task_name not in self.running:
            print(f"[错误] 任务 '{task_name}' 未开始")
            return

        start_time = self.running.pop(task_name)
        end_time = time.time()
        elapsed = end_time - start_time

        self.records.append((task_name, start_time, end_time, elapsed))
        print(f"[结束] {task_name} at {self._now_str()} | 耗时: {elapsed:.2f}s")

    @contextmanager
    def task(self, task_name: str):
        self.start(task_name)
        try:
            yield
        finally:
            self.end(task_name)

    def summary(self):
        if not self.records:
            print("暂无任务记录")
            return

        total = 0
        print("\n===== 耗时汇总 =====")
        for i, (name, st, et, el) in enumerate(self.records, 1):
            start_str = datetime.fromtimestamp(st).strftime("%H:%M:%S")
            end_str = datetime.fromtimestamp(et).strftime("%H:%M:%S")
            print(f"{i}. {name}: {start_str} -> {end_str} | {el:.2f}s")
            total += el

        print(f"总耗时: {total:.2f}s")
        print("=====================")

    def export_csv(self, filename="task_log.csv"):
        if not self.records:
            print("没有数据可导出")
            return

        with open(filename, "w", newline="", encoding="utf-8") as f:
            writer = csv.writer(f)
            writer.writerow(["任务名", "开始时间", "结束时间", "耗时(秒)"])

            for name, st, et, el in self.records:
                writer.writerow([
                    name,
                    datetime.fromtimestamp(st).strftime("%Y-%m-%d %H:%M:%S"),
                    datetime.fromtimestamp(et).strftime("%Y-%m-%d %H:%M:%S"),
                    f"{el:.2f}"
                ])

        print(f"已导出到 {filename}")

    @staticmethod
    def _now_str():
        return datetime.now().strftime("%Y-%m-%d %H:%M:%S")
